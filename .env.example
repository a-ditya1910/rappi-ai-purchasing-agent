# Gemini - free tier, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Which models work is account specific, and quotas are per model. Two traps:
#   - a model can appear in /models and still 404 on use. 2.5-flash does
#     exactly that for new keys.
#   - the free tier per-day cap is small. 3.6-flash ran out after ~32 calls.
# flash-lite has a more generous allowance, so it is the default. 3.6-flash
# reasons better if your quota allows it. The agent checks with a real call
# on startup and names working alternatives if the configured one fails.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
GEMINI_RPM_LIMIT=14

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=buyer
MYSQL_USER=buyer
MYSQL_PASSWORD=buyer
# Host port for the MySQL container. Change if 3306 is already taken locally.
MYSQL_PORT=3306
MYSQL_URL=jdbc:mysql://localhost:3306/buyer

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Services
PLATFORM_BASE_URL=http://localhost:8080
AGENT_BASE_URL=http://localhost:8100

# Fixed "today" so the demo and evals are reproducible
SIM_DATE=2026-03-10
