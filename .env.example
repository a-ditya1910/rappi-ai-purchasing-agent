# Gemini - free tier, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Which models work is account specific. A model can appear in the models list
# and still 404 on use - 2.5-flash does exactly that for new keys. The agent
# checks with a real call on startup and tells you what to switch to.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
GEMINI_RPM_LIMIT=14

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=buyer
MYSQL_USER=buyer
MYSQL_PASSWORD=buyer
# Host port for the MySQL container. Change if 3306 is already taken locally.
MYSQL_PORT=3306
MYSQL_URL=jdbc:mysql://localhost:3306/buyer

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Services
PLATFORM_BASE_URL=http://localhost:8080
AGENT_BASE_URL=http://localhost:8100

# Fixed "today" so the demo and evals are reproducible
SIM_DATE=2026-03-10
